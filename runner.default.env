# Version-controlled defaults. Put machine-specific overrides in runner.env.

APP_ID=4891121
ORG_NAME=xtool-org
APP_PRIVATE_KEY_FILE=./runner-private-key.pem

GITHUB_API_URL=https://api.github.com
GITHUB_RUNNER_URL=auto

TART_SOURCE_IMAGE=ghcr.io/cirruslabs/ubuntu:latest
TART_BASE_VM=xtool-runner-base
TART_CPU=4
TART_MEMORY_MB=8192
TART_DISK_GB=50
XCODE_APP_PATH=auto

# Softnet blocks private-network egress. Run ./scripts/setup-softnet.sh once
# before starting the runner. Use "shared" to opt out of Softnet filtering.
TART_NETWORK_MODE=softnet
TART_SOFTNET_ALLOW=

RUNNER_NAME_PREFIX=xtool-runner
RUNNER_LABELS=xtool-runner
RUNNER_GROUP=xtool-runners
RUNNER_RESTART_DELAY_SECONDS=5
VM_READY_TIMEOUT_SECONDS=180
